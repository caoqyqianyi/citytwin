    given-names: Qianyi
    email: caoqy.qianyi@gmail.com
repository-code: "https://github.com/caoqyqianyi/citytwin"
keywords:
  - geospatial
  - digital twin
  - CityJSON
  - 3D Tiles
  - OGC API
  - urban heat
  - GeoAI
  - provenance
